@inproceedings{ WOS:000237237603194,
Author = {Wang, ZM and Zhang, B and Song, KS and Li, F and Duan, HT},
Book-Group-Author = {IEEE},
Title = {Corn chlorophyll estimation with in situ collected hyperspectral
   reflectance data},
Booktitle = {IGARSS 2005: IEEE International Geoscience and Remote Sensing Symposium,
   Vols 1-8, Proceedings},
Series = {IEEE International Symposium on Geoscience and Remote Sensing (IGARSS)},
Year = {2005},
Pages = {2984-2986},
Note = {25th IEEE International Geoscience and Remote Sensing Symposium (IGARSS
   2005), Seoul, SOUTH KOREA, JUL 25-29, 2005},
Organization = {IEEE; IEEE Geosci \& Remote Sensing Soc; NASA; NOAA; USN Off Res; Japan
   Aerosp Explorat Agcy; Natl Polar orbiting Operat Environm Satellite
   Syst; Ball Aerosp \& Technologies Corp; Int Union Radio Sci; Elect \&
   Telecommun Res Inst; Korea Sci \& Engn Fdn; Korea Natl Tourism Org;
   Korea Telecommun},
Abstract = {Canopy reflectance of corn was collected with ASD FieldSpec during
   different growing stages, and simultaneously, contents of chlorophyll a
   and b are acquired. Vegetation indices of ratio analysis of reflectance
   spectra (RARS) and pigment-specific simple ratio (PSSR) are used to
   analyze the relationship between corn canopy hyperspectral reflectance
   and chlorophyll a and b content. It is found that RARS and PSSR arc
   useful vegetation indices for detecting chlorophyll content with
   hyperspectral Reflectance data. Still it was found that Backforward
   propagation (BP) neural network was an efficient data analyzing tools
   for predicting corn chlorophyll content with In-situ collected
   hyperspectral reflectance data. With the help of BP neural network, the
   estimation precision of corn chlorophyll with hyperspectral reflectance
   data could be improved greatly. Still more sample data need to be
   collected to calibrate the BP- neural network established for estimation
   corn chlorophyll content with hyperspectral reflectance data.},
