Title = {Phytopigments Profiling of Lactuca Sativa Leaf Chloroplast
   Photosystems via Vision-based Planar Chromatography},
Booktitle = {2020 IEEE 12TH INTERNATIONAL CONFERENCE ON HUMANOID, NANOTECHNOLOGY,
   INFORMATION TECHNOLOGY, COMMUNICATION AND CONTROL, ENVIRONMENT, AND
   MANAGEMENT (HNICEM)},
