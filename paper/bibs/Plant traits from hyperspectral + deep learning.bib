Month = {SEP-OCT},
Note = {72nd Congress of the Italian-Society-of-Physiology (SIF), Bari, ITALY,
   SEP 14-16, 2022},
Organization = {Italian Soc Physiol},
Abstract = {Solar-induced fluorescence (F) is crucial to monitor vegetation health,
   as it provides information about photosynthetic processes. Our new
   method, i-phi-MaLe, simultaneously estimates F spectra, Leaf Area Index
   (LAI), Chlorophyll Content (Cab), Absorbed Photosynthetic Active
   Radiation (APAR) and F Quantum Yield (Fqe) from canopy reflectance
   spectra by coupling the phasor approach with Machine Learning (ML)
   techniques. We validated i-phi-MaLe on simulations and spectra acquired
   for increasing spectrometer-canopy distances, up to 100 m (where O-2
   bands are affected by atmospheric oxygen absorption). The reliability of
   i-phi-MaLe in such complex experimental scenarios paves the way to new
   perspectives concerning the real time monitoring of vegetation stress
   status on high scales.},
