@article{ WOS:000806615700001,
Author = {Vasseur, Francois and Cornet, Denis and Beurier, Gregory and Messier,
   Julie and Rouan, Lauriane and Bresson, Justine and Ecarnot, Martin and
   Stahl, Mark and Heumos, Simon and Gerard, Marianne and Reijnen, Hans and
   Tillard, Pascal and Lacombe, Benoit and Emanuel, Amelie and Floret,
   Justine and Estarague, Aurelien and Przybylska, Stefania and Sartori,
   Kevin and Gillespie, Lauren M. and Baron, Etienne and Kazakou, Elena and
   Vile, Denis and Violle, Cyrille},
Title = {A Perspective on Plant Phenomics: Coupling Deep Learning and
   Near-Infrared Spectroscopy},
Journal = {FRONTIERS IN PLANT SCIENCE},
Year = {2022},
Volume = {13},
Month = {MAY 20},
Abstract = {The trait-based approach in plant ecology aims at understanding and
   classifying the diversity of ecological strategies by comparing plant
   morphology and physiology across organisms. The major drawback of the
   approach is that the time and financial cost of measuring the traits on
   many individuals and environments can be prohibitive. We show that
   combining near-infrared spectroscopy (NIRS) with deep learning resolves
   this limitation by quickly, non-destructively, and accurately measuring
   a suite of traits, including plant morphology, chemistry, and
   metabolism. Such an approach also allows to position plants within the
   well-known CSR triangle that depicts the diversity of plant ecological
   strategies. The processing of NIRS through deep learning identifies the
   effect of growth conditions on trait values, an issue that plagues
   traditional statistical approaches. Together, the coupling of NIRS and
   deep learning is a promising high-throughput approach to capture a range
   of ecological information on plant diversity and functioning and can
   accelerate the creation of extensive trait databases.},
