@article{ WOS:001598926900001,
Author = {Zhou, Xin and Wang, Jian and Zhao, Chunjiang and Sun, Jun and Liu, Yang
   and Shi, Lei and Cong, Sunli},
Title = {A novel method for zinc content detection in oilseed rape under gradient
   silicon treatments using hyperspectral imaging and self-supervised
   learning},
Journal = {MICROCHEMICAL JOURNAL},
Year = {2025},
Volume = {217},
Month = {OCT},
Abstract = {Accurate and rapid quantification of zinc (Zn) content in Zn-stressed
   oilseed rape was essential for enhancing both yield and edible quality.
   This study proposed an innovative method that integrated hyperspectral
   imaging technology with self-supervised learning (SSL) to improve the
   accuracy of Zn content detection. Specifically, a variational
   autoencoder with inverse autoregressive flow (VAE-IAF) was employed as
   the backbone model in the pre-training stage of the SSL framework to
   extract generalizable feature representations from numerous unlabeled
   hyperspectral data. In the subsequent fine-tuning stage, the pre-trained
   model weights were refined through supervised learning, and a spectral
   feature adaptation regression network was designed for Zn content
   prediction. Experimental results showed that the optimally fine-tuned
   model achieved high detection accuracy (R-p(2) = 0.97, RMSEP = 8 mg/kg,
   RPD = 6). The proposed method demonstrated great potential for broad
   applications in the compositional analysis of crops and food products.},
