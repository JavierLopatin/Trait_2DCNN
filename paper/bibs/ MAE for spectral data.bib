Year = {2025},
Pages = {1649-1653},
Note = {2025 International Geoscience and Remote Sensing
   Symposium-IGARSS-Annual, Brisbane, AUSTRALIA, AUG 03-08, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {The pre-training and fine-tuning paradigm has significantly advanced
   satellite remote sensing applications but remains underexplored for
   airborne Light Detection and Ranging (LiDAR) point clouds. In this
   study, we propose a self-supervised learning method based on masked
   autoencoders, specifically tailored for airborne LiDAR data. This design
   is motivated by the unique characteristics of airborne LiDAR, including
   significant elevation variations within scenes and complex geometries
   resulting from the interaction between varied terrain and surface
   objects. Our experiments demonstrate that this customized approach
   improves the transferability of the pre-trained representation and
   achieves superior fine-tuning performance compared to the original
   design on tasks such as tree species classification and point cloud
   segmentation. These findings highlight the potential of developing
   methods specifically for airborne LiDAR to maximize the effectiveness of
   pre-trained models. The code and pre-trained models for this study will
   be made publicly available at https://github.com/martianxiu/ALS
   pretraining.},
