Title = {CUSTOMIZING MASKED AUTOENCODERS FOR SELF-SUPERVISED LEARNING ON AIRBORNE
   LIDAR POINT CLOUDS},
Booktitle = {IGARSS 2025-2025 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING
   SYMPOSIUM},
