@article{ WOS:001732673500002,
Author = {Liu, Wei and Prasad, Saurabh and Crawford, Melba},
Title = {Advancing Efficient Vision Foundation Models for Analysis of
   Multispectral Imagery},
Journal = {IEEE JOURNAL OF SELECTED TOPICS IN APPLIED EARTH OBSERVATIONS AND REMOTE
   SENSING},
Year = {2026},
Volume = {19},
Pages = {10825-10841},
Abstract = {Vision foundation models (VFMs) based on self-supervised learning are
   highly valued in the analysis of RGB imagery for their ability to
   generalize well without labeled data. Foundation models are particularly
   suited for remote sensing applications, where datasets are large and
   high-quality labels are limited. Despite their potential, several
   challenges remain. First, traditional masked autoencoder techniques in
   multispectral data may focus primarily on reconstructing multispectral
   imagery information, potentially limiting their effectiveness in
   learning meaningful latent representations. Second, there is a lack of
   in-depth analysis of feature representations during self-supervised
   training, with evaluations often dependent on performance after
   fine-tuning. Third, the typically practice of full parameter fine-tuning
   in downstream tasks is computationally expensive. To address these
   challenges, a novel self-supervised VFM specifically designed for
   multispectral image analysis is proposed. The proposed approach utilizes
   latent representations from the encoder module to selectively
   reconstruct masked patches, reducing pretraining parameters and
   enhancing feature representation capabilities from the encoder. In
   addition, during the pretraining phase, weighted attention distance and
   feature map frequency are employed to explicitly analyze feature
   learning across both spatial and frequency domains. Leveraging the
   strong generalization ability gained from pretraining on a large-scale
   in-domain dataset, the model requires only a lightweight fine-tuning
   strategy to adapt to different downstream tasks, significantly reducing
   computational costs. Experiments on three downstream datasets
   demonstrate that the proposed model achieves competitive performance in
   both classification and segmentation tasks, with significantly fewer
   trainable parameters required in both the pretraining and fine-tuning
   phases.},
