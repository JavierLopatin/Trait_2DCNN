
@inproceedings{ WOS:001098971605042,
Author = {Moellenbrok, Lars and Demir, Beguem},
Book-Group-Author = {IEEE},
Title = {ACTIVE LEARNING GUIDED FINE-TUNING FOR ENHANCING SELF-SUPERVISED BASED
   MULTI-LABEL CLASSIFICATION OF REMOTE SENSING IMAGES},
Booktitle = {IGARSS 2023 - 2023 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING
   SYMPOSIUM},
Series = {IEEE International Symposium on Geoscience and Remote Sensing IGARSS},
Year = {2023},
