@inproceedings{ WOS:001697407700486,
Author = {Sahay, Rajas and Savakis, Andreas},
Book-Group-Author = {IEEE},
Title = {FINE-TUNING THE SEGMENT ANYTHING MODEL FOR EARTH OBSERVATION},
Booktitle = {IGARSS 2025-2025 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING
   SYMPOSIUM},
Series = {IEEE International Symposium on Geoscience and Remote Sensing IGARSS},
Year = {2025},
Pages = {2304+},
Note = {2025 International Geoscience and Remote Sensing
   Symposium-IGARSS-Annual, Brisbane, AUSTRALIA, AUG 03-08, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {The Segment Anything Model (SAM) is a foundation model that demonstrates
   impressive performance and generalization capabilities across domains.
   However, SAM's effectiveness diminishes when dealing with remote sensing
   data for earth observation. To address this limitation, we utilize and
   evaluate popular parameter-efficient fine-tuning strategies, namely
   prompt/prefix tuning, low rank adaptation (LoRA) and bottleneck
   adapters, to improve SAM's performance on earth observation data. Our
   comprehensive evaluation across multiple remote sensing datasets reveals
   that while the pretrained SAM model struggles with small object
   segmentation - a characteristic challenge in aerial imagery - our
   fine-tuning approach yields substantial improvements. Experimental
   results demonstrate that the fine-tuned model with LoRA achieves
   demonstrably improved performance, that makes SAM attractive for
   real-world applications.},
