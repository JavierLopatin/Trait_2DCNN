@inproceedings{ WOS:001098971605045,
Author = {Panigrahi, Akash and Verma, Sagar and Terris, Matthieu and Vakalopoulou,
   Maria},
Book-Group-Author = {IEEE},
Title = {HAVE FOUNDATIONAL MODELS SEEN SATELLITE IMAGES?},
Booktitle = {IGARSS 2023 - 2023 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING
   SYMPOSIUM},
Series = {IEEE International Symposium on Geoscience and Remote Sensing IGARSS},
Year = {2023},
Pages = {4998-5001},
Note = {IEEE International Geoscience and Remote Sensing Symposium (IGARSS),
   Pasadena, CA, JUL 16-21, 2023},
Organization = {IEEE; Inst Elect \& Elect Engineers, Geoscience \& Remote Sensing Soc},
Abstract = {This paper presents an investigation into the zero-shot performance of
   pre-trained foundation models on remote sensing tasks. Recent advances
   in self-supervised learning suggest that these models, when trained on
   vast amounts of unsupervised data, could potentially improve
   generalization across a number of downstream tasks. Our study offers an
   empirical evaluation of these models on standard remote-sensing
   benchmarks such as EuroSAT and BigEarthNet-S2, with the intent to
   confirm whether these models have encountered satellite imagery during
   their training phase. Moreover, we examine the impact of adding a
   geospatial domain-specific textual description of classes, contrasting
   it with the standard class-based prompts. Our findings indicate that the
   fine-tuned BLIP models exhibit superior zeroshot performance on these
   benchmarks compared to their standard counterparts, signifying that
   fine-tuning on standard benchmarks enhances performance. Furthermore,
