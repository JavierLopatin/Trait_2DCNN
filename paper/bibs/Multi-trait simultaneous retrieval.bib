@article{ WOS:000207618300020,
Author = {Satapathy, Sasmita and Dadhwal, V. K.},
Title = {PRINCIPAL COMPONENT INVERSION TECHNIQUE FOR THE RETRIEVAL OF LEAF AREA
   INDEX},
Journal = {PHOTONIRVACHAK-JOURNAL OF THE INDIAN SOCIETY OF REMOTE SENSING},
Year = {2005},
Volume = {33},
Number = {2},
Pages = {323-330},
Month = {JUN},
Abstract = {A simulation study has been carried out to investigate the Principal
   Component Inversion (PCI) technique for the retrieval of leaf area index
   (LAI). The PROSAIL model has been used for the forward analysis, i.e.,
   estimation of reflectance for various combinations of LAI, soil
   reflectance, leaf angle distribution (theta(1)), chlorophyll a+b
   concentration (C-ab), etc. Independent test on sample with LAI range
   0.1-7.0 indicated that the retrieved LAI from PCI has higher accuracy
   (RMSE=0.137) than the classical NDVI-LAI empirical approach
   (RMSE=1.139). The study needs to be extended to cover retrieval from
   different types of soil and simultaneous retrieval of different
   biophysical parameters viz., LAI, C-ab, theta(1) to test the wider
   applicability of the PCI technique.},
