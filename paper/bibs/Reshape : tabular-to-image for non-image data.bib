Title = {Semi-Autogeonous (SAG) Mill Overload Forecasting},
Booktitle = {PROGRESS IN PATTERN RECOGNITION, IMAGE ANALYSIS, COMPUTER VISION, AND
   APPLICATIONS, CIARP 2021},
Series = {Lecture Notes in Computer Science},
Year = {2021},
