@inproceedings{ WOS:000653136100464,
Author = {Malik, Afrah Elfatih Farah and Barin, Sezin and Yuksel, Mehmet Emin},
Book-Group-Author = {IEEE},
Title = {Accurate Classification of Heart Sound Signals for Cardiovascular
   Disease Diagnosis by Wavelet Analysis and Convolutional Neural Network:
   Preliminary Results},
Booktitle = {2020 28TH SIGNAL PROCESSING AND COMMUNICATIONS APPLICATIONS CONFERENCE
   (SIU)},
