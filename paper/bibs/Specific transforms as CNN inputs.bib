@article{ WOS:001492115600001,
Author = {Kahlessenane, Yaaqoub and Bouaziz, Fatiha and Siarry, Patrick},
Title = {ECG Heartbeats Classification Using Two-Dimensional Deep Learning
   Convolutional Neural Network},
Journal = {CIRCUITS SYSTEMS AND SIGNAL PROCESSING},
Year = {2025},
Volume = {44},
Number = {10},
Pages = {7505-7525},
Month = {OCT},
Abstract = {The heartbeats classification represents a very important tool in
   cardiology. Deep learning-based techniques for the analysis of ECG
   signals aid human experts in the appropriate diagnosis of cardiac
   diseases. This paper presents a two-dimensional deep learning technique
   for ECG heartbeats classification based on a convolutional neural
   network (CNN). We have considered five predominant kinds of ECG beats in
   MIT-BIH database, which are: Normal (N), Left bundle branch block (L),
   Right bundle branch block (R), Premature Ventricular Contraction (V),
   and Atrial Premature Contraction (A). The ECG recordings were first
   denoised and segmented into individual beats. Continuous wavelet
   transform was then applied to generate scalogram images from these
   beats, which were after used as inputs of the CNN neural network. The
   proposed system exhibits excellent performance, achieving a positive
   predictivity of 99.73\%, a sensitivity of 98.02\%, a precision of
   98.68\%, and an overall accuracy of 99.59\%.},
