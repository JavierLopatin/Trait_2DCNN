@article{ WOS:001654133200038,
Author = {Zhang, Tianxiang and Zeng, Yuxin and Han, Dubing and Liu, Li and Li,
   Jiangyun},
Title = {FSTNet: frequency spectral transformer for hyperspectral image
   classification},
Journal = {JOURNAL OF APPLIED REMOTE SENSING},
Year = {2025},
Volume = {19},
Number = {4},
Month = {OCT 1},
Abstract = {Hyperspectral images contain rich data information and have been widely
   used in various fields such as land cover classification, precision
   agriculture, water quality and pollution detection, ecological forest
   monitoring, and military target detection. Compared with standard RGB
   images, hyperspectral images provide hundreds of contiguous spectral
   bands, enabling detailed characterization of materials and fine
   differentiation of surface objects. This rich spectral information makes
   hyperspectral images highly suitable for high-precision applications
   such as land cover classification, precision agriculture, water quality
   monitoring, ecological forest assessment, and military target detection.
   In recent years, benefiting from the development of deep learning
   technology, methods based on convolutional neural networks and
   transformers have achieved classification accuracy superior to
   traditional methods in the field of hyperspectral image classification.
   Many studies have leveraged frequency information to improve feature
   extraction and enhance the accuracy of hyperspectral image
   classification. However, current research in hyperspectral
   frequency-domain analysis remains constrained by a predominant emphasis
   on spatial frequency features, often neglecting the significant spectral
   information inherent in the frequency domain. To overcome this
   limitation, we propose a hyperspectral image classification network
   based on the frequency spectral transformer (FSTNet). The frequency
   spectral transformer (FST) is proposed to simultaneously obtain
   information with spatial-spectral features and frequency spectral
   features, capturing subtle differences in features among different bands
   in the frequency domain to enhance the model's ability to represent
   frequency domain information. The efficient multiscale 3D separable
   convolution module is designed to capture multiscale spatial-spectral
   features as the basis for extracting frequency domain features. Finally,
   the spectral feature fusion module is proposed to explicitly model the
   spectral relationships of the extracted features and achieve the fusion
   of spatial-spectral-frequency features. Experimental results on three
   benchmark hyperspectral datasets (Indian Pines, Houston 2013, and
   Trento) demonstrate that the proposed FSTNet achieves state-of-the-art
   classification performance, surpassing existing convolutional neural
   network-based and transformer-based methods. Notably, on the most
   challenging Houston 2013 dataset, FSTNet attains an overall accuracy of
   94.65\%, outperforming recent advanced approaches such as MorphFormer
   and frequency-aware hierarchical Mamba by more than 2 percentage points,
   thereby validating its superior robustness and generalization capability
   in hyperspectral image classification.},
