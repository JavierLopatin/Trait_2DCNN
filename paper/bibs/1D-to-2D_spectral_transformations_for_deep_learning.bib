   Li, Shutao, Hunan Univ, Coll Elect \& Informat Engn, Changsha 410082, Peoples R China.
   Li, Shutao, Hunan Univ, Key Lab Visual Percept \& Artificial Intelligence, Changsha 410082, Peoples R China.},
DOI = {10.1109/TNNLS.2023.3313202},
