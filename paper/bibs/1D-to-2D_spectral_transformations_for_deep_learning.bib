Title = {Distribution of Operations in Heterogeneous Computing Systems for
   Processing Speech Signals},
Booktitle = {2021 IEEE 15TH INTERNATIONAL CONFERENCE ON APPLICATION OF INFORMATION
   AND COMMUNICATION TECHNOLOGIES (AICT2021)},
Series = {International Conference on Application of Information and Communication
   Technologies},
