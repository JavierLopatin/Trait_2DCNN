@article{ WOS:001693539000001,
Author = {Zheng, Bin and Yang, Jian and Li, Jingyan and Chen, Pu and Xu, Yupeng
   and Liu, Dan and Han, Yehua and Chu, Xiaoli},
Title = {Advances in deep learning for intelligent non-destructive spectral
   analysis: From preprocessing and data augmentation to interpretability,
   fusion, and transfer learning},
Journal = {TRAC-TRENDS IN ANALYTICAL CHEMISTRY},
Year = {2026},
Volume = {197},
Month = {APR},
Abstract = {Deep learning (DL) is driving a transition from expert-dependent
   chemometrics paradigm to a data-driven intelligent paradigm. This review
   summarizes DL progress in spectral analysis, covering the entire process
   from preprocessing and feature extraction to qualitative and
   quantitative modeling. It introduces representative DL architectures,
   such as convolutional neural network (CNN), recurrent neural network
   (RNN), generative adversarial network (GAN), and Transformer. It also
   elaborates on the applications of these architectures to various
   spectroscopic techniques, such as ultraviolet-visible (UV-Vis)
   spectroscopy, near-infrared (NIR) spectroscopy, Raman spectroscopy,
   terahertz spectroscopy, laser-induced breakdown spectroscopy (LIBS),
   X-ray fluorescence (XRF) spectroscopy, and hyperspectral imaging.
   Furthermore, it explores critical frontier technologies such as
   explainable AI, multispectral fusion, and transfer learning. The
   discussion extends to current datalevel and model-level challenges,
   including label scarcity, generalization limits, and deployment
   constraints. Finally, future research directions are proposed,
   highlighting the transition of spectral analysis towards an autonomous,
   robust, and interpretable paradigm.},
