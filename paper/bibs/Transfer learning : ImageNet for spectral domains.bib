@inproceedings{ WOS:001098971607152,
Author = {Chhapariya, Koushikey and Buddhiraju, Krishna Mohan and Kumar, Anil},
Book-Group-Author = {IEEE},
Title = {A SHUFFLED DILATED CONVOLUTIONAL NEURAL NETWORK FOR HYPERSPECTRAL IMAGE
   USING TRANSFER LEARNING},
Booktitle = {IGARSS 2023 - 2023 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING
   SYMPOSIUM},
Series = {IEEE International Symposium on Geoscience and Remote Sensing IGARSS},
Year = {2023},
Pages = {7547-7550},
Note = {IEEE International Geoscience and Remote Sensing Symposium (IGARSS),
   Pasadena, CA, JUL 16-21, 2023},
Organization = {IEEE; Inst Elect \& Elect Engineers, Geoscience \& Remote Sensing Soc},
Abstract = {Recently, Convolutional Neural Network (CNN) has been widely used for
   the classification of hyperspectral images. However, with the
   availability of limited training sample data in hyperspectral scenes,
   classification performance is majorly affected. In this research work,
   we propose a shuffled dilated CNN-based classification method for
   hyperspectral classification using a transfer learning approach. The
   proposed model consists of a dilated convolution layer to provide a
   larger receptive field and a shuffled block to enhance the connection
   between different layers. This helps in the development of a
   classification model having fewer parameters with better efficiency. To
   evaluate the performance, hyperspectral datasets have been considered
   from the same sensor as well as cross-sensor with similar spectral and
   spatial features. We observed an improvement of 4\% overall accuracy
   using the transfer learning approach compared to the classification
   results without using the transfer learning approach. The experimental
   results demonstrate the effectiveness of using the proposed methodology
   with a transfer learning approach for the classification of
   hyperspectral data with a limited number of labeled training samples.},
