@inproceedings{ WOS:000615970404095,
Author = {Larsen, Jacob Sogaard and Clemmensen, Line},
Book-Group-Author = {IEEE},
Title = {WEIGHT SHARING AND DEEP LEARNING FOR SPECTRAL DATA},
Booktitle = {2020 IEEE INTERNATIONAL CONFERENCE ON ACOUSTICS, SPEECH, AND SIGNAL
   PROCESSING},
Series = {International Conference on Acoustics Speech and Signal Processing
   ICASSP},
Year = {2020},
