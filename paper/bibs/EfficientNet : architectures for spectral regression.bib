@article{ WOS:001573420000003,
Author = {Zhao, Jing and Li, Hong and Liu, Junping and Zhao, Menglong and Yan,
   Zhaoxia},
Title = {Integration of spatial attention mechanism into 1D-CNN for prediction of
   wheat leaf nitrogen concentration from UAV-borne hyperspectral imagery},
Journal = {COMPUTERS AND ELECTRONICS IN AGRICULTURE},
Year = {2025},
Volume = {239},
Number = {A},
Month = {DEC},
Abstract = {Leaf nitrogen content (LNC), a critical indicator of crop nitrogen
   status, precisely reflects the nitrogen supply and demand in plants. In
   field agriculture, large-scale and high-precision monitoring of LNC in
   wheat is essential for optimizing nitrogen fertilizer application. This
   study integrates unmanned aerial vehicle (UAV)-borne hyperspectral data
   with a one-dimensional convolutional neural network (1D-CNN) to enable
   visual, rapid, and precise prediction of wheat LNC under field
   conditions. To effectively mitigate interference from redundant
   wavelengths and enhance the model's regression accuracy, we incorporate
   a spatial attention mechanism (SAM) into the 1DCNN model, thereby
   amplifying the signals of feature bands closely associated with LNC. The
   research systematically compares the improved 1D-CNN model that
   integrates SAM (SAM-1D-CNN) with two traditional chemometric models
   commonly used for crop LNC regression-partial least squares regression
   (PLSR) and support vector regression (SVR), as well as with a
   one-dimensional residual network (1D-ResNet) and a baseline 1D-CNN
   model. Model performance is evaluated using the coefficient of
   determination (R2), root mean square error of cross-validation (RMSECV),
   and mean absolute percentage error (MAPE) as quantitative metrics. The
   comparison results reveal that the SAM-1D-CNN model achieves the best
   performance, with specific values of R2 = 0.8415, RMSECV = 3.7517 g/kg,
   and MAPE = 9.3544 \%. This research not only underscores the significant
   potential of artificial neural network models in leveraging UAV-borne
   hyperspectral data for crop LNC prediction but also demonstrates that
   the integration of the SAM substantially enhances the model's capability
   to select spectral features, thereby offering a novel and effective
   approach for crop LNC assessment.},
