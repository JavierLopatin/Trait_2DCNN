@article{ WOS:001409244500001,
Author = {Cui, Yao and Lv, Ziqi and Fan, Yuhan and Song, Yang and Wu, Yuxin and
   Zhao, Xuan and Diao, Changlong and Zhao, Caili and Xu, Zhiqiang and
   Wang, Weidong},
Title = {Spatial-spectral joint preprocessing for hyperspectral image analysis
   using 3D-ResNet: Application to coal ash content estimation},
Journal = {MEASUREMENT},
Year = {2025},
Volume = {246},
Month = {MAR 31},
Abstract = {Coal ash content estimation using hyperspectral image (HSI) is a
   promising yet challenging task due to the high dimensionality and
   intricate data structure of HSI. Existing methods, primarily designed
   for RGB images, struggle to model the complex spatial-spectral
   correlations inherent in HSI data. To address these challenges, this
   study proposes a novel coal ash content estimation approach integrating
   a spatial-spectral joint preprocessing algorithm with the 3D-ResNet
   network. The proposed method systematically optimizes both spatial and
   spectral dimensions of HSI data to enhance model performance. Firstly, a
   sliding window averaging method was developed to identify the optimal
   spatial size for HSI data, enabling the model to capture fine spatial
   details. This approach reduced the MAE by 0.12 \% and MSE by 0.14 \%,
   with the CS-1.0 metric increasing by 7 \%. Secondly, spectral
   preprocessing methods were evaluated to mitigate scattering effects and
   improve spectral feature extraction. Among them, the SNV algorithm
   showed superior performance, further reducing prediction errors.
   Thirdly, a correlation-based band weighting method, particularly
   Spearman's correlation, effectively captured nonlinear relationships
   between spectral bands and ash content. It highlighted the critical
   importance of the 1200-1600 nm band range, further enhancing the model's
   accuracy. Comparative experiments demonstrated that the proposed
   3D-ResNet-34 model outperformed traditional 2D and 3D convolutional
   networks, achieving the lowest MAE (1.095 \%) and MSE (1.892 \%) among
   tested benchmarks. Overall, the spatial-spectral joint preprocessing
   method increased the CS-1.0 metric by approximately 12 \%, validating
   its effectiveness and practical applicability. This work offers a robust
   framework for improving HSI-based coal ash content estimation,
   addressing key limitations of existing methods.},
