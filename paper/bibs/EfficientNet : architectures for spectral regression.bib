@article{ WOS:001597459100001,
Author = {Cohen, Abigail and Muriki, Harsh and Sun, Yuming and Qin, Zhihao and
   Gan, Lu and Chen, Yongsheng},
Title = {A Proof-of-concept for non-destructive lettuce nutrient assessment using
   vision transformers and residual networks on raw hyperspectral imagery},
Journal = {SMART AGRICULTURAL TECHNOLOGY},
Year = {2025},
Volume = {12},
Month = {DEC},
Abstract = {Hyperspectral imaging (HSI) shows promise for non-destructive
   measurement of tissue nutrient concentrations in plants. However, many
   HSI analysis approaches rely on extensive preprocessing, traditional
   statistical methods, and pixel averaging that require subject matter
   expertise and sacrifice spatial information. This reduces their
   prospects for adoption in precision agricultural applications, where
   automated, end-to-end approaches are needed. To address this gap, we
   explored end-to-end deep learning (DL) to process raw hyperspectral data
   (400-1100 nm). This study presents a novel application of vision
   transformers (ViT) for a regression task in precision nutrient
   management, comparing it to popular residual network (ResNet)
   architectures (ResNet-34, ResNet-50, and ResNet-101) and providing a
   proof-of-concept for nutrient status estimation from raw proximal
   hyperspectral imagery. To explore the applicability of these approaches,
   we conducted a pilot-scale longitudinal hydroponic lettuce growth study
   with destructive sampling, imaging plants grown with different applied
   nutrient concentrations under pilot-scale greenhouse conditions. Results
   reveal considerable variability within and between these models under
   the same data splits, with ViT and ResNet-34 showing particular promise
   for N estimation, achieving average test R2 of 0.65 and 0.73 R2 without
   radiometric calibration and with limited preprocessing (resizing and
   normalization). These results demonstrate the potential for developing
   DL approaches that support end-to-end nutrient control automation in
   precision agriculture.},
