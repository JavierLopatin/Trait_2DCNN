@article{ WOS:001649020600001,
Author = {Pan, Xuedi and Bin, Ronghua and Zhao, Xiaozhong and Jin, Huiqing and Wu,
   Xiaohua and Shao, Xinguang},
Title = {Prediction model of moisture content in hyper-spectral smoke based on
   dot-product-attention mechanism},
Journal = {ENGINEERING RESEARCH EXPRESS},
Year = {2025},
Volume = {7},
Number = {4},
Month = {DEC 31},
Abstract = {Traditional methods for predicting the moisture content of tobacco
   flakes have problems such as long time consumption, small measurement
   range, and difficulty in intuitively reflecting the surface moisture
   distribution of tobacco flakes. To raise the accuracy of predicting the
   moisture content of tobacco, a hyperspectral tobacco moisture content
   prediction model based on dot-product-attention mechanism is introduced.
   The study first constructs a feature extraction model based on
   dot-product-attention mechanism, and then integrates spectral spatial
   features to construct a moisture content prediction model. The outcomes
   reveal that compared with other methods, feature extraction based on
   dot-product-attention mechanism has the highest accuracy and the lowest
   mean square error. When the iteration count is 500, the accuracy and
   mean square error are 0.94 and 0.07, respectively. The prediction of
   moisture content in tobacco based on the fusion spectral spatial feature
   model has the shortest time and the lowest average absolute error. When
   the iteration count is 500, the prediction time and average absolute
   error are 3.5 seconds and 0.012, respectively. The introduced
   hyperspectral smoke moisture content prediction model based on
   dot-product-attention mechanism has superior performance and can provide
   technical support for predicting smoke moisture content.},
