@article{ WOS:001582895100002,
Author = {Ke, Jiawei and Li, Yan and Hong, Mengdie and Zhang, Kefeng and Yang,
   Yunyun and Wang, Taiwei and Li, Xu and Wang, Lingyan and Xie, Liangliang
   and Xie, Dan},
Title = {Qualitative and quantitative analysis of adulterated Antarctic krill oil
   (AKO) based on residual network (ResNet) and three-dimensional
   fluorescence spectroscopy},
Journal = {JOURNAL OF FOOD COMPOSITION AND ANALYSIS},
Year = {2025},
Volume = {148},
Number = {1},
Month = {DEC},
Abstract = {Antarctic krill oil (AKO), valued for its rich omega-3 fatty acids and
   bioactive components, faces adulteration threats compromising consumer
   safety and market integrity. This study develops a rapid,
   non-destructive method for AKO authentication by integrating
   three-dimensional fluorescence spectroscopy with a ResNet-based
   convolutional neural network (CNN). Spectral data from pure and
   adulterated AKO samples were processed and input into the customized
   ResNet model. The approach achieved superior classification accuracy
   compared to Support Vector Machines (SVM) and enabled high-precision
   regression prediction of adulteration levels, significantly
   outperforming traditional PCA-PLS methods. Results demonstrate that
   combining CNN with three-dimensional fluorescence spectroscopy provides
   an effective tool for detecting counterfeit AKO.},
