@article{ WOS:001301200800001,
Author = {Yu, Yan and Huang, Jipeng and Wang, Lianming and Liang, Shili},
Title = {A 1D-inception-ResNet based global detection model for thin-skinned
   multifruit spectral quantitative analysis},
Journal = {FOOD CONTROL},
Year = {2025},
Volume = {167},
Month = {JAN},
Abstract = {Near-infrared spectroscopy (NIRS) analysis technology has important
   research and application value in the inspection of agricultural product
   quality due to its nondestructive characteristics. Deep learning methods
   represented by convolutional neural networks (CNNs) reduce the reliance
   on expert experience and prior knowledge in spectral analysis. They can
   automatically extract effective feature information from the original
   spectral data to improve the prediction accuracy of the model. However,
   the diverse characteristics of fruit varieties present a challenge to
   the robustness of the model. This study proposes1D-Inception-ResNet, an
   end-to-end CNN model for multifruit spectral quantitative analysis. The
   effectiveness of the model is validated on two thin-skinned fruit
   datasets with similar physicochemical properties. The root mean square
   error of prediction (RMSEP) for soluble solids content (SSC) and dry
   matter (DM) were 0.48 degrees Brix and 0.60 \%, and the coefficients of
   determination of prediction (Rp2) p 2 ) were 0.95 and 0.89,
   respectively. Compared with traditional partial least squares regression
   (Rp2 p 2 of 0.86 and 0.80, RMSEP of 0.84 degrees Brix and 0.81 \%,
   respectively) and extreme learning machine (Rp2 p 2 of 0.82 and 0.77,
   RMSEP of 0.95 degrees Brix and 0.86 \%, respectively), our proposed
   method resulted in a lower RMSEP (46.1\% and 28.1\% lower, respectively)
   and higher R P 2 (13.1\% and 13.4\% higher, respectively) for SSC and DM
   prediction. The results show that compared to other linear and nonlinear
   algorithms, 1D-Inception-ResNet significantly enhances the modeling
   effectiveness. Furthermore, external validation using a new sample set
   showed RMSEP values of 0.62 degrees Brix and 1.45 \% for the SSC and DM
   models of Inception-ResNet, respectively. In conclusion, using an
   appropriate CNN network structure to establish a global model for
   diverse fruits expands the application scope of the model and improves
   the prediction stability across different species, which is significant
   in the future application of agricultural products and foods.},
