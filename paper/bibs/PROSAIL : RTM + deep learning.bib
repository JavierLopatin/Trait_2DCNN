@inproceedings{ WOS:001578294100007,
Author = {Masemola, Cecilia and Bonnet, Wessel and Cho, Moses},
Book-Group-Author = {IEEE},
Title = {COUPLING RADIATIVE TRANSFER MODELS AND MACHINE LEARNING FOR CROP TRAIT
   RETRIEVAL IN DRYLAND ECOSYSTEMS},
Booktitle = {2025 13TH INTERNATIONAL CONFERENCE ON AGRO-GEOINFORMATICS,
   AGRO-GEOINFORMATICS},
Series = {International Conference on Agro-Geoinformatics},
Year = {2025},
Pages = {32-36},
Note = {13th International Conference on Agro
   Geoinformatics-Agro-Geoinformatics, Boulder, CO, JUL 07-10, 2025},
Abstract = {Radiative Transfer Models (RTMs) such as PROSAIL, which integrates
   leaf-level (PROSPECT) and canopy-level (SAIL) reflectance simulations,
   are increasingly employed to support biophysical trait retrieval in crop
   monitoring applications. In this study, we assess and compare the
   performance of three PROSAIL configurationsPROSPECT-5 + SAIL, PROSPECT-D
   + SAIL, and PROSPECT-PRO + SAIL-for estimating Leaf Area Index (LAI) and
   Canopy Chlorophyll Content (CCC) in dryland maize systems using
   synthetic Sentinel-2 reflectance data. Results from synthetic test
   datasets indicate that the PROSPECT-PRO + SAIL configuration achieved
   superior performance, with LAI retrieved at an R-2 of 0.88 and RMSE of
   0.35 m(2)/m(2), and CCC estimated at an R-2 of 0.83 and RMSE of 4.1 mu
   g/cm(2). These outcomes highlight the advantage of using the enhanced
   biochemical and structural parameterizations in PROSPECT-PRO, especially
   under semi-arid cropping conditions. Comparative analysis confirms that
   this configuration consistently yielded the lowest normalized RMSE
   (nRMSE) for both LAI (9.5\%) and CCC (10.7\%) across the variants
   tested. The findings substantiate the added value of improved leaf
   optical modeling for accurate trait estimation and suggest that
   PROSPECT-PRO + SAIL provides a robust forward modeling basis for
   data-driven crop monitoring frameworks.},
Publisher = {IEEE},
Address = {345 E 47TH ST, NEW YORK, NY 10017 USA},
